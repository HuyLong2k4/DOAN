# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Food?retryWrites=true&w=majority

# JWT — sinh ngẫu nhiên: `openssl rand -hex 64`
JWT_SECRET=replace_me_with_a_long_random_string

# Google OAuth (Client ID dùng để verify id_token từ mobile)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps (server-side distance matrix)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Admin — DÁN nguyên nội dung JSON service account (1 dòng)
# Hoặc dùng GOOGLE_APPLICATION_CREDENTIALS=/path/to/file.json (mount vào container)
FIREBASE_CREDENTIALS_JSON=

# CORS — danh sách origin cho phép, phân cách bằng dấu phẩy.
# Để trống hoặc "*" sẽ cho phép tất cả (chỉ dùng dev).
ALLOWED_ORIGINS=https://admin.example.com,http://localhost:5173
