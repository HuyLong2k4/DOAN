# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Food?retryWrites=true&w=majority

# JWT — sinh ngẫu nhiên: `openssl rand -hex 64`
JWT_SECRET=replace_me_with_a_long_random_string

# CORS — danh sách origin cho phép, phân cách bằng dấu phẩy.
# Để trống hoặc "*" sẽ cho phép tất cả (chỉ dùng dev).
ALLOWED_ORIGINS=https://admin.example.com,http://localhost:5173

# Google Distance Matrix — khoá để lấy quãng đường đường bộ thực tế.
# Để trống thì hệ thống tự dùng công thức Haversine (đường chim bay) thay thế.
GOOGLE_MAPS_API_KEY=
